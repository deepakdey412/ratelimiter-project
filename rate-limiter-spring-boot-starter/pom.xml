<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.ratelimiter</groupId>
        <artifactId>ratelimiter-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rate-limiter-spring-boot-starter</artifactId>
    <name>rate-limiter-spring-boot-starter</name>
    <description>
        Dependency-aggregator only - no source code in this module at all,
        by convention. Add this single dependency to your Spring Boot app
        and rate limiting is auto-configured for you. Mirrors how real
        Spring Boot starters (e.g. spring-boot-starter-data-jpa) work: they
        contain no code of their own either, just a pom.xml pulling in the
        actual autoconfigure + library jars.
    </description>

    <dependencies>
        <!-- Pulls in rate-limiter-spring-boot-autoconfigure, which
             transitively pulls in rate-limiter-core, spring-boot-autoconfigure,
             spring-boot-starter-aop, and spring-boot-starter-web. This one
             line is this module's entire dependency list. -->
        <dependency>
            <groupId>com.example.ratelimiter</groupId>
            <artifactId>rate-limiter-spring-boot-autoconfigure</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>

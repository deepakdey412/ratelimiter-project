<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.ratelimiter</groupId>
    <artifactId>ratelimiter-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ratelimiter-parent</name>
    <description>
        Multi-module rate-limiting library + Spring Boot starter. NOT built
        on top of spring-boot-starter-parent as an ancestor - that parent
        bundles the spring-boot-maven-plugin/repackaging behavior meant for a
        single deployable application, which is wrong for a library made of
        several non-runnable jars. Instead this parent just imports the
        spring-boot-dependencies BOM for centralized version management, the
        same approach Spring Boot's own starter modules use internally.
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.5.16</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Centralizes every Spring Boot / Spring Framework / common
                 third-party (JUnit, etc.) dependency version in one place.
                 Every child module below declares dependencies with NO
                 <version> tag; the version always comes from here, so
                 bumping Spring Boot is a one-line change at this single
                 location instead of hunting through 4 child poms. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>rate-limiter-core</module>
        <module>rate-limiter-spring-boot-autoconfigure</module>
        <module>rate-limiter-spring-boot-starter</module>
        <module>rate-limiter-demo-app</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>17</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/deepakdey412/ratelimiter-project</url>
        </repository>
    </distributionManagement>
</project>
